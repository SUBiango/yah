---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { isPublished, resolveSlug, metaDescription, resolveOgImage, canonicalUrl } from '../lib/posts';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter(isPublished);
  return posts.map((post) => ({
    params: { slug: resolveSlug(post) },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}
const { post } = Astro.props;
const { Content } = await render(post);

const slug = resolveSlug(post);
const canonical = canonicalUrl(slug);
const og = resolveOgImage(post) as { src: string };
const date = post.data.publishDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---
<BaseLayout
  title={`${post.data.title} | Young Access Hub`}
  description={metaDescription(post)}
  canonical={canonical}
  ogImage={og.src}
  ogType="article"
>
  <article class="article container">
    <header class="article__header">
      <h1>{post.data.title}</h1>
      <p class="article__meta">
        <span>{post.data.author}</span> ·
        <time datetime={post.data.publishDate.toISOString()}>{date}</time>
      </p>
      {post.data.tags.length > 0 && (
        <ul class="article__tags">
          {post.data.tags.map((tag) => <li>{tag}</li>)}
        </ul>
      )}
    </header>

    <Image
      class="article__hero"
      src={post.data.featuredImage}
      alt={post.data.title}
      widths={[600, 1000, 1600]}
      sizes="(max-width: 800px) 100vw, 800px"
      format="webp"
      loading="eager"
    />

    <div class="article__body">
      <Content />
    </div>

    <p class="article__back"><a href={import.meta.env.BASE_URL}>&larr; Back to all articles</a></p>
  </article>
</BaseLayout>

<style>
  .article {
    max-width: 48rem;
    /* Clear the fixed nav (--nav-height) so the title isn't covered. */
    padding-block: calc(var(--nav-height) + var(--space-6)) var(--space-8);
  }
  .article__header {
    text-align: center;
    margin-bottom: 2rem;
  }
  .article__header h1 {
    margin-bottom: 0.75rem;
  }
  .article__meta {
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }
  .article__tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
    padding: 0;
    margin: 1rem 0 0;
  }
  .article__tags li {
    background: var(--color-primary-lt);
    color: var(--color-primary-dk);
    border-radius: 999px;
    padding: 0.15rem 0.75rem;
    font-size: var(--font-size-sm);
  }
  .article__hero {
    width: 100%;
    height: auto;
    border-radius: 12px;
    margin-bottom: 2.5rem;
  }
  .article__body :global(p) {
    margin-bottom: 1.25rem;
    line-height: var(--line-height);
  }
  .article__body :global(h2) {
    margin: 2rem 0 1rem;
  }
  .article__body :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 10px;
    margin: 1.5rem 0;
  }
  .article__back {
    margin-top: 3rem;
  }
</style>
