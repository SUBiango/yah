---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { isPublished, resolveSlug, metaDescription, resolveOgImage, canonicalUrl, readingMinutes, slugify } from '../lib/posts';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter(isPublished);
  return posts.map((post) => ({
    params: { slug: resolveSlug(post) },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}
const { post } = Astro.props;
const { Content } = await render(post);

const slug = resolveSlug(post);
const canonical = canonicalUrl(slug);
const og = resolveOgImage(post) as { src: string };
const minutes = readingMinutes(post.body ?? '');
const share = {
  facebook: `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(canonical)}`,
  x: `https://twitter.com/intent/tweet?url=${encodeURIComponent(canonical)}&text=${encodeURIComponent(post.data.title)}`,
  whatsapp: `https://wa.me/?text=${encodeURIComponent(`${post.data.title} ${canonical}`)}`,
  linkedin: `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(canonical)}`,
};
const date = post.data.publishDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---
<BaseLayout
  title={`${post.data.title} | Young Access Hub`}
  description={metaDescription(post)}
  canonical={canonical}
  ogImage={og.src}
  ogType="article"
>
  <article class="article container">
    <header class="article__header">
      <h1>{post.data.title}</h1>
      <p class="article__meta">
        <span>{post.data.author}</span> ·
        <time datetime={post.data.publishDate.toISOString()}>{date}</time> ·
        <span>{minutes} min read</span>
      </p>
      {post.data.tags.length > 0 && (
        <ul class="article__tags">
          {post.data.tags.map((tag) => (
            <li><a href={`${import.meta.env.BASE_URL}?tag=${slugify(tag)}`}>{tag}</a></li>
          ))}
        </ul>
      )}
    </header>

    <Image
      class="article__hero"
      src={post.data.featuredImage}
      alt={post.data.title}
      widths={[600, 1000, 1600]}
      sizes="(max-width: 800px) 100vw, 800px"
      format="webp"
      loading="eager"
    />

    <div class="article__body">
      <Content />
    </div>

    <div class="article__share">
      <span class="article__share-label">Share this article</span>
      <div class="share-buttons">
        <a class="share-btn share-btn--facebook" href={share.facebook} target="_blank" rel="noopener noreferrer" aria-label="Share on Facebook">
          <i class="fab fa-facebook-f" aria-hidden="true"></i>
        </a>
        <a class="share-btn share-btn--x" href={share.x} target="_blank" rel="noopener noreferrer" aria-label="Share on X">
          <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
          </svg>
        </a>
        <a class="share-btn share-btn--whatsapp" href={share.whatsapp} target="_blank" rel="noopener noreferrer" aria-label="Share on WhatsApp">
          <i class="fab fa-whatsapp" aria-hidden="true"></i>
        </a>
        <a class="share-btn share-btn--linkedin" href={share.linkedin} target="_blank" rel="noopener noreferrer" aria-label="Share on LinkedIn">
          <i class="fab fa-linkedin-in" aria-hidden="true"></i>
        </a>
        <button type="button" class="share-btn share-btn--copy" data-url={canonical} aria-label="Copy link">
          <i class="fas fa-link" aria-hidden="true"></i>
        </button>
        <span class="share-copied" role="status" aria-live="polite" hidden>Link copied!</span>
      </div>
    </div>

    <p class="article__back"><a href={import.meta.env.BASE_URL}>&larr; Back to all articles</a></p>
  </article>

  <script is:inline>
    (function () {
      var btn = document.querySelector('.share-btn--copy');
      var toast = document.querySelector('.share-copied');
      if (!btn) return;
      btn.addEventListener('click', function () {
        var url = btn.getAttribute('data-url');
        var done = function () {
          if (toast) {
            toast.hidden = false;
            setTimeout(function () { toast.hidden = true; }, 1800);
          }
        };
        var fail = function () { /* copy failed: don't show the success toast */ };
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(url).then(done).catch(fail);
        } else {
          var t = document.createElement('textarea');
          t.value = url; document.body.appendChild(t); t.select();
          var ok = false;
          try { ok = document.execCommand('copy'); } catch (e) { ok = false; }
          document.body.removeChild(t);
          if (ok) { done(); } else { fail(); }
        }
      });
    })();
  </script>
</BaseLayout>

<style>
  .article {
    max-width: 48rem;
    /* Clear the fixed nav (--nav-height) so the title isn't covered. */
    padding-block: calc(var(--nav-height) + var(--space-6)) var(--space-8);
  }
  .article__header {
    text-align: center;
    margin-bottom: 2rem;
  }
  .article__header h1 {
    margin-bottom: 0.75rem;
  }
  .article__meta {
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }
  .article__tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
    padding: 0;
    margin: 1rem 0 0;
  }
  .article__tags li a {
    display: inline-block;
    background: var(--color-primary-lt);
    color: var(--color-primary-dk);
    border-radius: 999px;
    padding: 0.15rem 0.75rem;
    font-size: var(--font-size-sm);
    text-decoration: none;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .article__tags li a:hover {
    background: var(--color-primary);
    color: #fff;
  }
  .article__hero {
    width: 100%;
    height: auto;
    border-radius: 12px;
    margin-bottom: 2.5rem;
  }
  .article__body :global(p) {
    margin-bottom: 1.25rem;
    line-height: var(--line-height);
  }
  .article__body :global(h2) {
    margin: 2rem 0 1rem;
  }
  .article__body :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 10px;
    margin: 1.5rem 0;
  }
  .article__share {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .article__share-label {
    font-weight: 700;
    color: var(--color-text);
  }
  .share-buttons {
    display: flex;
    gap: 0.75rem;
  }
  .share-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    color: #fff;
    text-decoration: none;
    font-size: 1.05rem;
    transition: transform 0.15s ease, opacity 0.15s ease;
  }
  .share-btn:hover {
    transform: translateY(-3px);
    opacity: 0.92;
  }
  .share-btn--facebook { background: #1877f2; }
  .share-btn--x        { background: #000; }
  .share-btn--whatsapp { background: #25d366; }
  .share-btn--linkedin { background: #0a66c2; }
  .share-btn--copy     { background: #475569; border: none; cursor: pointer; }
  .share-copied {
    align-self: center;
    font-size: var(--font-size-sm);
    color: var(--color-success, #1a9e6e);
    font-weight: 600;
  }
  .article__back {
    margin-top: 2.5rem;
  }
</style>
