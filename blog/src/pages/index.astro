---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { publishedSorted, uniqueTags, slugify } from '../lib/posts';

const posts = publishedSorted(await getCollection('blog'));
const tags = uniqueTags(posts);
const canonical = new URL(import.meta.env.BASE_URL, Astro.site).href;
---
<BaseLayout
  title="Blog | Young Access Hub"
  description="Stories, updates, and lessons from Young Access Hub's work with young people across Kono District, Sierra Leone."
  canonical={canonical}
>
  <header class="page-header text-center">
    <div class="container">
      <span class="badge badge--light mb-3">News &amp; Insights</span>
      <h1 class="page-header__title" style="margin-top:var(--space-3);">YAH Blog</h1>
      <p class="page-header__subtitle">
        Stories, updates, and lessons from our work with young people across Kono District.
      </p>
    </div>
  </header>

  {tags.length > 0 && (
    <section class="section--sm" style="border-bottom:2px solid var(--color-border);">
      <div class="container">
        <div class="flex flex-wrap gap-2" style="justify-content:center;" id="tag-filters">
          <button class="btn btn--outline btn--sm filter-btn filter-btn--active" data-filter="all">All Posts</button>
          {tags.map((tag) => (
            <button class="btn btn--outline btn--sm filter-btn" data-filter={slugify(tag)}>{tag}</button>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container">
      {posts.length === 0 ? (
        <p class="blog-empty">No articles published yet — check back soon.</p>
      ) : (
        <div class="blog-grid" id="blog-grid">
          {posts.map((post, i) => <PostCard post={post} priority={i === 0} />)}
        </div>
      )}
      <p class="blog-empty" id="no-results" hidden>No posts match that tag.</p>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    var filters = document.getElementById('tag-filters');
    var grid = document.getElementById('blog-grid');
    if (!filters || !grid) return;
    var cards = Array.prototype.slice.call(grid.querySelectorAll('.post-card'));
    var empty = document.getElementById('no-results');

    filters.addEventListener('click', function (e) {
      var btn = e.target.closest('.filter-btn');
      if (!btn) return;
      filters.querySelectorAll('.filter-btn').forEach(function (b) {
        b.classList.remove('filter-btn--active');
      });
      btn.classList.add('filter-btn--active');

      var filter = btn.getAttribute('data-filter');
      var shown = 0;
      cards.forEach(function (card) {
        var tags = (card.getAttribute('data-tags') || '').split(' ');
        var show = filter === 'all' || tags.indexOf(filter) !== -1;
        card.hidden = !show;
        if (show) shown++;
      });
      if (empty) empty.hidden = shown !== 0;
    });
  })();
</script>

<style>
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 2rem;
  }
  .blog-empty {
    text-align: center;
    color: var(--color-text-muted);
    padding-block: 2rem;
  }
</style>
