---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { publishedSorted } from '../lib/posts';

const posts = publishedSorted(await getCollection('blog'));
const canonical = new URL(import.meta.env.BASE_URL, Astro.site).href;
---
<BaseLayout
  title="Blog | Young Access Hub"
  description="Stories, updates, and lessons from Young Access Hub's work with young people across Kono District, Sierra Leone."
  canonical={canonical}
>
  <header class="page-header text-center">
    <div class="container">
      <span class="badge badge--light mb-3">News &amp; Insights</span>
      <h1 class="page-header__title" style="margin-top:var(--space-3);">YAH Blog</h1>
      <p class="page-header__subtitle">
        Stories, updates, and lessons from our work with young people across Kono District.
      </p>
    </div>
  </header>

  <section class="section">
    <div class="container">
      {posts.length === 0 ? (
        <p class="blog-empty">No articles published yet — check back soon.</p>
      ) : (
        <div class="blog-grid">
          {posts.map((post, i) => <PostCard post={post} priority={i === 0} />)}
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 2rem;
  }
  .blog-empty {
    text-align: center;
    color: var(--color-text-muted);
    padding-block: 2rem;
  }
</style>
